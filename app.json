{
  "expo": {
    "name": "새 메신저",
    "slug": "owlet",
    "version": "0.1.0",
    "scheme": "owlet",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/withOwletNative"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.owlet.app"
    },
    "android": {
      "package": "com.owlet.app"
    }
  }
}
