{
  "expo": {
    "name": "새 메신저",
    "slug": "owlet",
    "version": "0.1.0",
    "scheme": "owlet",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/withOwletNative",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.owlet.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.owlet.app"
        ]
      }
    },
    "android": {
      "package": "com.owlet.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
